# Store the real contents as the GitHub Actions secret DEPLOY_ENV_FILE.
# Do not commit a real .env file.

# GitHub Actions SSH deployment.
PROD_SSH_HOST=158.179.170.118
PROD_SSH_USER=ubuntu
PROD_SSH_PORT=22
# Create with: base64 -w 0 ~/.ssh/your_private_key
PROD_SSH_PRIVATE_KEY_B64=base64-encoded-private-key
PROD_APP_DIR=/home/ubuntu/daehyun-backend

# Application deployment.
PUBLIC_PORT=18080
SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/daehyun
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=daehyun
IMAGE_UPLOAD_DIR=/upload/images
TZ=Asia/Seoul
DB_BIND_ADDRESS=127.0.0.1

# Required only when the GHCR package is private.
GHCR_USERNAME=
GHCR_TOKEN=

# Host Nginx.
APPLY_HOST_NGINX=true
HOST_NGINX_SERVER_NAME=api.xn--vk1b177d.com
HOST_NGINX_UPSTREAM=http://127.0.0.1:18080
HOST_NGINX_SSL_CERT=/etc/letsencrypt/live/api.xn--vk1b177d.com/fullchain.pem
HOST_NGINX_SSL_KEY=/etc/letsencrypt/live/api.xn--vk1b177d.com/privkey.pem
HOST_NGINX_CONF_PATH=/etc/nginx/conf.d/api.xn--vk1b177d.com.conf

# Monitoring.
ENABLE_MONITORING=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
