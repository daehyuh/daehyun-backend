# Store the real contents as the GitHub Actions secret DEPLOY_ENV_FILE.
# Do not commit a real .env file.

# GitHub Actions SSH deployment.
PROD_SSH_HOST=158.179.170.118
PROD_SSH_USER=ubuntu
PROD_SSH_PORT=22
# Paste the private key file contents without indentation, not the public key from authorized_keys.
# Public keys start with ssh-rsa or ssh-ed25519 and will not work here.
PROD_SSH_PRIVATE_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
paste-your-private-key-here
-----END OPENSSH PRIVATE KEY-----'
PROD_APP_DIR=/home/ubuntu/daehyun-backend

# Container image.
# CI/CD overwrites APP_IMAGE and APP_IMAGE_TAG with the image built from the current commit.
APP_IMAGE=ghcr.io/daehyuh/daehyun-backend

# Required only when the GHCR package is private.
GHCR_USERNAME=
GHCR_TOKEN=

# Docker deployment.
PUBLIC_PORT=18080
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=daehyun
TZ=Asia/Seoul
DB_BIND_ADDRESS=127.0.0.1
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Host Nginx.
APPLY_HOST_NGINX=true
HOST_NGINX_SERVER_NAME=api.xn--vk1b177d.com
HOST_NGINX_UPSTREAM=http://127.0.0.1:18080
HOST_NGINX_SSL_CERT=/etc/letsencrypt/live/api.xn--vk1b177d.com/fullchain.pem
HOST_NGINX_SSL_KEY=/etc/letsencrypt/live/api.xn--vk1b177d.com/privkey.pem
HOST_NGINX_CONF_PATH=/etc/nginx/conf.d/api.xn--vk1b177d.com.conf

# Monitoring.
ENABLE_MONITORING=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB
ALERTMANAGER_BIND_ADDRESS=127.0.0.1
ALERTMANAGER_PORT=9093

# Spring settings.
SPRING_APPLICATION_NAME=daehyun-backend
SPRING_MAIN_ALLOW_BEAN_DEFINITION_OVERRIDING=true
SERVER_ERROR_INCLUDE_MESSAGE=always
SERVER_ERROR_INCLUDE_BINDING_ERRORS=always
SERVER_ERROR_INCLUDE_STACKTRACE=always
SERVER_ERROR_INCLUDE_EXCEPTION=false
SPRING_PROFILES_INCLUDE=db,jwt,security,file

SPRING_JPA_SHOW_SQL=true
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MariaDBDialect
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.mariadb.jdbc.Driver
SPRING_DATASOURCE_URL=jdbc:mariadb://db:3306/daehyun
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=2592000000

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.xn--vk1b177d.com/login/oauth2/code/google
GOOGLE_OAUTH_SCOPE=profile,email

ADMIN_PASSWORD=change-me
ADMIN_BASIC_USERNAME=admin
ADMIN_BASIC_PASSWORD=change-me

FRONTEND_URL=https://xn--vk1b177d.com
FRONTEND_DOMAIN=xn--vk1b177d.com
IMAGE_UPLOAD_DIR=/upload/images
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
